# ============================================================
# my-agent 环境变量模板
# 使用方法：cp .env.example .env，然后填入真实 Key
# ============================================================

# --- 统一配置（推荐）: 框架读取这 4 个变量，自动识别 provider ---
# 注意: 模型必须在魔搭在役清单里(可用 client.models.list() 查询, 2025-10实测可用):
#   Qwen/Qwen3.5-27B / ZhipuAI/GLM-4.7-Flash / deepseek-ai/DeepSeek-V4-Pro 等
LLM_MODEL_ID=Qwen/Qwen3.5-27B
LLM_API_KEY=your-modelscope-api-key
LLM_BASE_URL=https://api-inference.modelscope.cn/v1/
LLM_TIMEOUT=60

# --- 备用：ModelScope 专用变量（provider="modelscope" 时使用）---
# MODELSCOPE_API_KEY=your-modelscope-api-key
